# Cloudflare Workers static-asset caching (audit 2026-07-20).
# Content-hashed bundles and the OFL fonts are immutable; stable-named
# icons/OG/screenshots change only on a rebrand, so a month is safe.
# HTML and the /api/* + /llms* + sitemap routes are served by the worker
# with their own Cache-Control and are unaffected by this file.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=2592000

/screenshots/*
  Cache-Control: public, max-age=2592000
