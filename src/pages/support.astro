---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// One purpose: contributing via GitHub. No donations, no wallet, no sponsors —
// the project is free and open source; support means contribution.
---

<Layout
  title="Ethereum Beat — SUPPORT · contribute on GitHub"
  description="Ethereum Beat is free and open source. The way to support it is to contribute on GitHub — propose a metric, fix a bug, or share an idea."
>
  <main class="flex min-h-dvh w-screen flex-col items-center justify-center gap-8 px-8 py-16 text-center">
    <p class="micro flex items-center gap-2 text-[color:var(--ink-soft)]">
      <span class="red-dot"></span>
      <span>SUPPORT // CONTRIBUTE ON GITHUB</span>
    </p>

    <h1 class="max-w-2xl font-grotesk font-extrabold leading-tight" style="font-size: clamp(1.8rem, 4.5vw, 3.6rem)">
      HELP IT<br />KEEP BEATING
    </h1>

    <p class="mono-label max-w-md text-[color:var(--ink-soft)]">
      Ethereum Beat is free and open source. There’s nothing to buy and no
      donations — the way to support it is to contribute: propose a metric, fix
      a bug, or share an idea.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="https://github.com/ethereumbeat/ethereum-beat" class="cmd-chip !no-underline"><span>CONTRIBUTE ON GITHUB</span></a>
      <a href="/" class="cmd-chip !no-underline"><span>← BACK TO THE BEAT</span></a>
    </div>
  </main>
</Layout>
