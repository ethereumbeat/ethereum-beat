---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// A deliberately quiet page. Not a channel, not in the sitemap, not promoted
// on the homepage. Reachable from /about and the README for anyone who wants
// to help keep the instrument running. No prices, no market framing — this is
// upkeep, not a product.

// TODO(maintainer): replace with the real receiving address before publishing.
const ETH_ADDRESS = '0x0000000000000000000000000000000000000000';
const ENS = 'ethereumbeat.eth';
const SPONSORS = 'https://github.com/sponsors/ethereumbeat';
---

<Layout
  title="Ethereum Beat — SUPPORT · keep the instrument running"
  description="Ethereum Beat is open source and runs on free tiers. If it's useful to you, here are a few quiet ways to help keep it running. No paid tier, no ads."
>
  <main class="flex min-h-dvh w-screen flex-col items-center justify-center gap-8 px-8 py-16 text-center">
    <p class="micro flex items-center gap-2 text-[color:var(--ink-faint)]">
      <span class="red-dot"></span>
      <span>SUPPORT // UPKEEP, NOT A PRODUCT</span>
    </p>

    <h1 class="max-w-2xl font-grotesk font-extrabold leading-tight" style="font-size: clamp(1.8rem, 4.5vw, 3.6rem)">
      KEEP THE<br />INSTRUMENT RUNNING
    </h1>

    <p class="mono-label max-w-md text-[color:var(--ink-soft)]">
      Ethereum Beat is open source and runs on free tiers. There’s no paid tier,
      no ads, and nothing to buy. If it’s useful to you, a few quiet ways to
      chip in — entirely optional.
    </p>

    <!-- the three ways, understated -->
    <div class="flex w-full max-w-md flex-col gap-3">
      <div class="brackets brackets-ink flex flex-col items-start gap-1 px-5 py-4 text-left">
        <span class="micro text-[color:var(--ink-faint)]">GITHUB SPONSORS</span>
        <a href={SPONSORS} class="mono-label !no-underline hover:font-bold text-[color:var(--ink)]">
          github.com/sponsors → ethereumbeat
        </a>
      </div>

      <div class="brackets brackets-ink flex flex-col items-start gap-1 px-5 py-4 text-left">
        <span class="micro text-[color:var(--ink-faint)]">ENS</span>
        <span class="font-mono text-[color:var(--ink)] select-all" style="font-size: 0.95rem">{ENS}</span>
      </div>

      <div class="brackets brackets-ink flex flex-col items-start gap-1 px-5 py-4 text-left">
        <span class="micro text-[color:var(--ink-faint)]">ETH / EVM ADDRESS</span>
        <code class="select-all break-all text-[color:var(--ink)]" style="font-size: 0.8rem">{ETH_ADDRESS}</code>
        <span class="micro text-[color:var(--ink-faint)]">Send only on Ethereum mainnet or an L2 you trust.</span>
      </div>
    </div>

    <p class="mono-label max-w-md text-[color:var(--ink-soft)]">
      Not looking to donate? Contributing a metric, filing a bug, or just using
      and sharing the site helps just as much.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/about#contribute" class="cmd-chip !no-underline"><span>WAYS TO CONTRIBUTE</span></a>
      <a href="https://github.com/ethereumbeat/ethereum-beat" class="cmd-chip !no-underline"><span>SOURCE → GITHUB</span></a>
      <a href="/" class="cmd-chip !no-underline"><span>← BACK TO THE BEAT</span></a>
    </div>
  </main>
</Layout>
