---
import Layout from '../../layouts/Layout.astro';
import BeatStage from '../../components/BeatStage';
import type { OverlayMetric } from '../../components/PulseOverlay';
import SectionHeader from '../../components/SectionHeader';
import { fetchSeries, type AggMode } from '../../lib/aggregate';
import { formatDelta, DELTA_LABELS } from '../../lib/format';
import { pulseMeta, siteOrigin } from '../../lib/site';
import { licenseFor } from '../../lib/sources';

export const prerender = false;

const { metric } = Astro.params;
const { DB } = Astro.locals.runtime.env;

interface MetaRow {
  metric_key: string;
  label: string;
  category: string;
  unit: string;
  description: string;
  source_name: string;
  source_url: string;
  agg_mode: AggMode;
  caption: string | null;
}

const meta = await DB.prepare('SELECT * FROM metric_meta WHERE metric_key = ?1')
  .bind(metric)
  .first<MetaRow>();

// Unknown / unmatched key: a real 404 status, rendered in the site's own
// grammar (command bar + margin frame come from the layout) rather than a
// bare white page. Everything below only runs for a real metric.
if (!meta) Astro.response.status = 404;

const origin = siteOrigin(Astro.locals.runtime.env);

let overlayMetric: OverlayMetric | null = null;
let initialPoints: Awaited<ReturnType<typeof fetchSeries>> = [];
let dataset: Record<string, unknown> | null = null;
let title = 'Ethereum Beat — metric not found';
let description = `No tracked metric matches “${metric}”. It may have been renamed, or never existed.`;

if (meta) {
  const latest = await DB.prepare(
    'SELECT date, value FROM metrics WHERE metric_key = ?1 ORDER BY date DESC LIMIT 1',
  )
    .bind(metric)
    .first<{ date: string; value: number }>();

  initialPoints = await fetchSeries(DB, meta.metric_key, 'm', meta.agg_mode);

  // headline delta: latest daily value vs the previous day
  const prevDay = await DB.prepare(
    'SELECT value FROM metrics WHERE metric_key = ?1 ORDER BY date DESC LIMIT 1 OFFSET 1',
  )
    .bind(metric)
    .first<{ value: number }>();
  const delta =
    latest && prevDay && prevDay.value !== 0
      ? formatDelta(((latest.value - prevDay.value) / Math.abs(prevDay.value)) * 100)
      : null;

  // the caption line (dp10c): the metric_meta override wins, else the daily
  // delta — the same rule the home arc and share images use
  const caption = meta.caption?.trim()
    ? meta.caption.trim().toUpperCase()
    : delta
      ? `${delta} ${DELTA_LABELS['d']}`
      : null;

  // overlay seed: the dial mounts underneath and this metric's detail opens
  // on load (pass 12). SEO title/description/canonical/OG + the Dataset
  // JSON-LD below all stay server-rendered.
  overlayMetric = {
    metric_key: meta.metric_key,
    label: meta.label,
    category: meta.category,
    unit: meta.unit,
    description: meta.description,
    source_name: meta.source_name,
    source_url: meta.source_url,
    caption,
    agg_mode: meta.agg_mode,
    latest: latest ?? null,
  };

  // Dataset JSON-LD (spec §18.6): coverage from the stored series, licence
  // of the underlying source, distribution pointing at the open API
  const coverage = await DB.prepare(
    'SELECT MIN(date) AS first, MAX(date) AS last FROM metrics WHERE metric_key = ?1',
  )
    .bind(metric)
    .first<{ first: string | null; last: string | null }>();
  dataset = {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${meta.label} — Ethereum`,
    description: meta.description,
    url: `${origin}/pulse/${meta.metric_key}`,
    ...(coverage?.first && coverage?.last ? { temporalCoverage: `${coverage.first}/${coverage.last}` } : {}),
    license: licenseFor(meta.source_name, meta.source_url),
    isAccessibleForFree: true,
    creditText: `Source: ${meta.source_name}`,
    creator: { '@type': 'Organization', name: meta.source_name, url: meta.source_url },
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${origin}/api/metric/${meta.metric_key}`,
      },
    ],
  };

  title = pulseMeta(meta.label, meta.description).title;
  description = meta.description;
}
---

<Layout title={title} description={description} jsonLd={dataset ? [dataset] : []}>
  <div class="channel-glyph" transition:name="channel-glyph" aria-hidden="true">1</div>
  {
    meta ? (
      <BeatStage client:load initialOverlay={{ metric: overlayMetric!, initialRange: 'm', initialPoints }} />
    ) : (
      <main class="mx-auto flex h-dvh max-w-2xl flex-col items-center justify-center gap-7 px-6 pb-28 text-center">
        <SectionHeader index="404" title="metric not found" subtitle="no such series in the registry" accent />
        <p class="mono-label max-w-md text-[color:var(--ink-soft)]">
          <span class="text-[color:var(--ink)]">/pulse/{metric}</span> is not a tracked metric. It may have been
          renamed, or never existed. Every real metric is reachable from the beat.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="/" class="cmd-chip !no-underline">
            <kbd>ESC</kbd>
            <span>back to beat</span>
          </a>
          <a href="/about" class="cmd-chip !no-underline">
            <span>about</span>
          </a>
        </div>
      </main>
    )
  }
  {
    !meta && (
      <script is:inline>
        {`document.addEventListener('keydown',function(e){if(e.key==='Escape'){window.location.href='/';}});`}
      </script>
    )
  }
</Layout>
