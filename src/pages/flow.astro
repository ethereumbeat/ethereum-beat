---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader';
import FlowChannel from '../components/FlowChannel';
import { routeMeta } from '../lib/site';

export const prerender = false;
const rm = routeMeta('/flow');
---

<Layout title={rm.title} description={rm.description}>
  <div class="channel-glyph" transition:name="channel-glyph" aria-hidden="true">4</div>
  <div class="channel-dock" aria-hidden="true">
    <SectionHeader index="04" title="flow" subtitle="live transaction telemetry" size="sm" />
  </div>
  <main class="mx-auto flex h-dvh max-w-6xl flex-col px-4 pb-28 pt-10 lg:px-8">
    <div class="min-h-0 flex-1">
      <FlowChannel client:only="react" />
    </div>
  </main>
</Layout>
