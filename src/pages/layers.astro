---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader';
import LayersChannel from '../components/LayersChannel';
import { routeMeta } from '../lib/site';

export const prerender = false;
const rm = routeMeta('/layers');
---

<Layout title={rm.title} description={rm.description}>
  <div class="channel-glyph" transition:name="channel-glyph" aria-hidden="true">6</div>
  <div class="channel-dock" aria-hidden="true">
    <SectionHeader index="06" title="layers" subtitle="the onchain economy" size="sm" />
  </div>
  <main class="mx-auto flex h-dvh max-w-6xl flex-col channel-body px-4 pt-10 lg:px-8">
    <div class="min-h-0 flex-1 overflow-hidden">
      <LayersChannel client:only="react" />
    </div>
  </main>
</Layout>
