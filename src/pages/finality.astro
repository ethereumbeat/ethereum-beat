---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader';
import FinalityChannel from '../components/FinalityChannel';
import { routeMeta } from '../lib/site';

export const prerender = false;
const rm = routeMeta('/finality');
---

<Layout title={rm.title} description={rm.description}>
  <div class="channel-glyph" transition:name="channel-glyph" aria-hidden="true">5</div>
  <div class="channel-dock" aria-hidden="true">
    <SectionHeader index="05" title="finality" subtitle="proposed to final" size="sm" />
  </div>
  <main class="mx-auto flex h-dvh max-w-6xl flex-col channel-body px-4 pt-8 lg:px-8">
    <div class="min-h-0 flex-1 overflow-hidden">
      <FinalityChannel client:only="react" />
    </div>
  </main>
</Layout>
