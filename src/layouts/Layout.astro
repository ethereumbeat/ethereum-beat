---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import CommandBar from '../components/CommandBar.astro';
import DPad from '../components/DPad.astro';
import MarginFrame from '../components/MarginFrame';
import { siteOrigin, ROUTES, SITE_NAME, siteJsonLd } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** route-specific JSON-LD blocks, appended after the site-wide ones */
  jsonLd?: object[];
}

const {
  title,
  description = 'The pulse of Ethereum: censorship resistance, open source, privacy and security, one beat per slot.',
  jsonLd = [],
} = Astro.props;
const path = Astro.url.pathname;

// canonicals always point at the canonical host, wherever this is deployed
const origin = siteOrigin(Astro.locals?.runtime?.env);
const normalized = path === '/' ? '/' : path.replace(/\/$/, '');
const canonical = origin + normalized;

// social card: per-channel build-time renders under /og/ (see
// scripts/build-og.mjs); /pulse/* shares the generic pulse card
const channel = ROUTES.find((r) => r.path === normalized);
const ogImage = `${origin}/og/${channel?.og ?? (normalized.startsWith('/pulse/') ? 'pulse' : 'beat')}.png`;
const ogAlt = channel
  ? `${SITE_NAME} — ${channel.channel} channel card: ${channel.oneLine}`
  : `${SITE_NAME} share card: ${description}`;

const jsonLdBlocks = [...siteJsonLd(origin), ...jsonLd];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <link rel="preload" href="/fonts/departure-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/martian-mono-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ethereum Beat" href={`${origin}/feed.xml`} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbf9" />
    <ClientRouter fallback="animate" />
    <script is:inline>
      // theme before first paint; system preference as the default.
      // theme-color follows each theme's --paper so the browser chrome matches.
      // (pass 15: seven themes, cycled with +/-; T still toggles the first two.)
      window.THEME_COLORS = {
        light: '#fbfbf9', dark: '#0a0a0a', swiss: '#ffffff', terminal: '#050805',
        fluffy: '#f7f1ff', sketch: '#f4f1e8', splitflap: '#14140f',
      };
      const t =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', window.THEME_COLORS[t] ?? '#fbfbf9');
    </script>
  </head>
  <body class="grain crt">
    <!-- SKETCH theme: a cheap wobble filter for stroke geometry (applied to
         svg strokes only, never <text>, so numerals/labels stay crisp) -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <filter id="sketch-wobble" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" />
      </filter>
    </svg>

    <slot />

    <MarginFrame client:only="react" transition:persist="margin-frame" />

    <CommandBar path={path} />

    <DPad />
    <!-- drag ghost: the snap-zone preview while dragging the command bar -->
    <div id="cmd-ghost" class="cmd-ghost hidden" transition:persist aria-hidden="true"></div>

    <!-- TV-style OSD on channel switch -->
    <div id="osd" class="osd hidden" transition:persist aria-hidden="true"></div>

    <!-- keyboard shortcuts overlay, styled like the system -->
    <div
      id="kbd-overlay"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-[color:var(--paper)]/90"
      role="dialog"
      aria-modal="true"
      aria-label="Keyboard shortcuts"
    >
      <div class="border border-[color:var(--hairline)] bg-[color:var(--paper)] px-8 py-6">
        <p class="micro mb-4 flex items-center gap-2">
          <span class="red-dot"></span>
          <span>KEYBOARD // OPERATING MANUAL</span>
        </p>
        <table class="mono-label border-collapse">
          <tbody>
            {
              [
                ['1…6', 'channels: beat · nodes · blobs · flow · finality · layers'],
                ['A', 'channel: about'],
                ['← →', 'previous / next metric (beat · detail)'],
                ['ENTER', 'open metric detail (beat)'],
                ['SPACE', 'hold / resume rotation (beat)'],
                ['D W M Q Y', 'chart range (detail)'],
                ['X', 'share (beat · detail)'],
                ['ESC', 'step out: modal → detail → page → channel 1'],
                ['S', 'sound on / off (beat)'],
                ['T', 'toggle ink / bone'],
                ['+ / −', 'cycle theme (seven: ink · bone · swiss · terminal · fluffy · sketch · split-flap)'],
                ['?', 'this overlay'],
              ].map(([k, what]) => (
                <tr class="hairline-t">
                  <td class="py-1.5 pr-8 font-bold text-[color:var(--ink)]">{k}</td>
                  <td class="py-1.5 text-[color:var(--ink-soft)]">{what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <script>
      import { navigate } from 'astro:transitions/client';

      // ── persistent controller: runs once, survives every channel switch ──
      const CHANNELS = { 1: '/', 2: '/nodes', 3: '/blobs', 4: '/flow', 5: '/finality', 6: '/layers', a: '/about' };
      const CHANNEL_NAMES: Record<string, string> = {
        '/': 'CH 01 — BEAT', '/nodes': 'CH 02 — NODES', '/blobs': 'CH 03 — BLOBS',
        '/flow': 'CH 04 — FLOW', '/finality': 'CH 05 — FINALITY', '/layers': 'CH 06 — LAYERS', '/about': 'CH A — ABOUT',
      };
      const CYCLE = ['/', '/nodes', '/blobs', '/flow', '/finality', '/layers'];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const here = (href: string) => (href === '/' ? location.pathname === '/' : location.pathname.startsWith(href));

      (window as any).channelCut = (href: string) => {
        if (here(href)) return;
        void navigate(href);
      };

      // ── seven themes (pass 15) ──────────────────────────────────────
      // +/- (and = for + without shift) cycle; T still toggles the first two
      // (INK/BONE). The current theme name flashes as an OSD on switch and
      // the command-bar chip shows it. Choice persists in localStorage.
      const THEME_ORDER = ['light', 'dark', 'swiss', 'terminal', 'fluffy', 'sketch', 'splitflap'];
      const THEME_NAMES: Record<string, string> = {
        light: 'INK', dark: 'BONE', swiss: 'SWISS', terminal: 'TERMINAL',
        fluffy: 'FLUFFY', sketch: 'SKETCH', splitflap: 'SPLIT-FLAP',
      };
      const THEME_COLORS: Record<string, string> = (window as any).THEME_COLORS;

      const currentTheme = () => document.documentElement.dataset.theme ?? 'light';
      const themeNum = (t: string) => String(THEME_ORDER.indexOf(t) + 1).padStart(2, '0');

      const syncThemeColor = () => {
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', THEME_COLORS[currentTheme()] ?? '#fbfbf9');
      };

      // the command-bar theme chip shows the current theme name
      const syncThemeChip = () => {
        const label = document.querySelector('#command-bar [data-theme-name]');
        if (label) label.textContent = THEME_NAMES[currentTheme()] ?? 'INK';
      };

      const applyThemeChoice = (next: string, announce: boolean) => {
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncThemeColor();
        syncThemeChip();
        if (announce) flashOsd(`THEME ${themeNum(next)} — ${THEME_NAMES[next]}`);
      };

      // T: toggle between the first two (INK/BONE)
      const toggleTheme = () => {
        applyThemeChoice(currentTheme() === 'dark' ? 'light' : 'dark', true);
      };
      // +/-: cycle forward/back through all seven
      const cycleTheme = (dir: number) => {
        const i = THEME_ORDER.indexOf(currentTheme());
        const next = THEME_ORDER[(((i === -1 ? 0 : i) + dir) % THEME_ORDER.length + THEME_ORDER.length) % THEME_ORDER.length];
        applyThemeChoice(next, true);
      };

      // the shared OSD: huge pixel type, bottom-left, glitch-cuts out. Used by
      // channel switches and theme switches. Under reduced motion it appears
      // and hides statically (the CSS animations are gated off).
      let osdTimer: ReturnType<typeof setTimeout>;
      const flashOsd = (text: string) => {
        const osd = document.getElementById('osd');
        if (!osd) return;
        clearTimeout(osdTimer);
        osd.textContent = text;
        osd.classList.remove('hidden', 'osd-out');
        osdTimer = setTimeout(() => {
          if (reduced) {
            osd.classList.add('hidden');
            return;
          }
          osd.classList.add('osd-out');
          osd.addEventListener('animationend', () => osd.classList.add('hidden'), { once: true });
        }, 1200);
      };

      const overlay = () => document.getElementById('kbd-overlay');
      const toggleOverlay = (force?: boolean) => {
        const el = overlay();
        if (!el) return;
        const show = force ?? el.classList.contains('hidden');
        el.classList.toggle('hidden', !show);
        el.classList.toggle('flex', show);
      };

      const flash = (chip: Element) => {
        chip.classList.remove('cmd-pressed');
        void (chip as HTMLElement).offsetWidth;
        chip.classList.add('cmd-pressed');
      };

      // ── d-pad nav overlay ──────────────────────────────────────────
      // light the matching keycap on a real key press (restart the flash)
      const flashDpad = (key: string) => {
        const cap = document.querySelector(`#dpad .dpad-key[data-key="${key}"]`);
        if (!cap) return;
        cap.classList.remove('dpad-pressed');
        void (cap as HTMLElement).offsetWidth;
        cap.classList.add('dpad-pressed');
        cap.addEventListener('animationend', () => cap.classList.remove('dpad-pressed'), { once: true });
      };
      // left/right only cycle metrics on BEAT — dim them elsewhere
      const syncDpad = () => {
        const pad = document.getElementById('dpad');
        pad?.classList.toggle('dpad-metric-off', location.pathname !== '/');
      };
      // teach that the keys work: one pulse on load / after every swap
      const pulseDpad = () => {
        if (reduced) return;
        const pad = document.getElementById('dpad');
        if (!pad) return;
        pad.classList.remove('dpad-pulse');
        void pad.offsetWidth;
        pad.classList.add('dpad-pulse');
        pad.addEventListener('animationend', () => pad.classList.remove('dpad-pulse'), { once: true });
      };

      // delegation: the d-pad keycaps are real controls — dispatch the
      // matching arrow key so pointer/touch and keyboard share one path
      document.addEventListener('click', (e) => {
        const cap = (e.target as HTMLElement).closest('#dpad .dpad-key') as HTMLElement | null;
        if (!cap?.dataset.key) return;
        cap.blur();
        flashDpad(cap.dataset.key);
        window.dispatchEvent(new KeyboardEvent('keydown', { key: cap.dataset.key, bubbles: true }));
      });

      // delegation: chips and strip buttons keep working across swaps
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const chip = t.closest('.cmd-chip') as HTMLElement | null;
        if (!chip || !chip.dataset.keys) {
          if (chip?.closest('#kbd-overlay')) toggleOverlay(false);
          return;
        }
        chip.blur();
        flash(chip);
        if (chip.dataset.channel) {
          (window as any).channelCut(chip.dataset.channel);
          return;
        }
        const key = chip.dataset.keys.split('|').pop()!;
        window.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true }));
      });
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).id === 'kbd-overlay') toggleOverlay(false);
      });

      const cycleChannel = (dir: number) => {
        const idx = CYCLE.findIndex(here);
        (window as any).channelCut(CYCLE[((idx === -1 ? 0 : idx) + dir + CYCLE.length) % CYCLE.length]);
      };

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = (e.target as HTMLElement | null)?.tagName ?? '';
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
        const lk = e.key.toLowerCase();
        // flash the matching command-bar chip
        const chip = [...document.querySelectorAll('#command-bar .cmd-chip')].find((c) =>
          (c as HTMLElement).dataset.keys?.toLowerCase().split('|').includes(lk === ' ' ? ' ' : lk),
        );
        if (chip) flash(chip);
        // light the d-pad keycap on any real arrow press (dim L/R do nothing
        // off BEAT, but the flash still shows the key was received)
        if (e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Enter') flashDpad(e.key);
        if (lk === 'arrowup' || lk === 'arrowdown') {
          e.preventDefault();
          cycleChannel(lk === 'arrowdown' ? 1 : -1);
          return;
        }
        if (CHANNELS[lk as keyof typeof CHANNELS]) {
          (window as any).channelCut(CHANNELS[lk as keyof typeof CHANNELS]);
          return;
        }
        switch (lk) {
          case '?':
            e.preventDefault();
            toggleOverlay();
            break;
          case 'escape':
            if (!overlay()?.classList.contains('hidden')) toggleOverlay(false);
            else if (location.pathname !== '/') (window as any).channelCut('/');
            break;
          case 't':
            toggleTheme();
            break;
          case '+':
          case '=': // = is + without shift
            e.preventDefault();
            cycleTheme(1);
            break;
          case '-':
          case '_':
            e.preventDefault();
            cycleTheme(-1);
            break;
          case 'b':
          case 'n':
            (window as any).channelCut(lk === 'b' ? '/' : '/nodes');
            break;
        }
      });

      // theme survives every swap: the incoming document has no data-theme,
      // so re-apply from localStorage synchronously before paint
      const applyTheme = () => {
        const t = localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
        syncThemeColor();
        syncThemeChip();
      };
      document.addEventListener('astro:after-swap', applyTheme);
      // the command bar re-renders per page, so re-label its theme chip
      document.addEventListener('astro:page-load', syncThemeChip);
      syncThemeChip();

      // d-pad: keep the metric pair's active/dim state route-correct, and
      // pulse once to teach the keys on every fresh view
      document.addEventListener('astro:after-swap', syncDpad);
      // astro:page-load fires on the initial load and after every soft nav
      document.addEventListener('astro:page-load', () => {
        syncDpad();
        pulseDpad();
      });

      // OSD after every soft navigation (channel name)
      document.addEventListener('astro:after-swap', () => {
        if (reduced) return;
        const label = CHANNEL_NAMES[Object.keys(CHANNEL_NAMES).find(here) ?? ''];
        if (label) flashOsd(label);
      });

      // ── draggable command bar (pass 15 item 4) ──────────────────────
      // Grab the bar background (not chips) and drop near an edge to dock
      // there, or in the centre for a floating palette. A ghost previews the
      // snap zone; position persists; double-click the handle resets to the
      // bottom. Keyboard equivalents are unaffected. Mobile keeps it fixed.
      const coarse = matchMedia('(pointer: coarse)').matches;
      const bar = () => document.getElementById('command-bar');
      const ghostEl = () => document.getElementById('cmd-ghost');
      let dock = localStorage.getItem('cmdDock') ?? 'bottom';
      let floatPos: { x: number; y: number } | null = (() => {
        try {
          return JSON.parse(localStorage.getItem('cmdFloatPos') ?? 'null');
        } catch {
          return null;
        }
      })();

      const applyDock = (d: string) => {
        const b = bar();
        if (!b) return;
        b.classList.remove('cmd-dock-top', 'cmd-dock-left', 'cmd-dock-right', 'cmd-dock-float');
        if (d !== 'bottom') b.classList.add('cmd-dock-' + d);
        document.documentElement.dataset.dock = d;
        if (d === 'float' && floatPos) {
          b.style.setProperty('--cmd-x', floatPos.x + 'px');
          b.style.setProperty('--cmd-y', floatPos.y + 'px');
        } else {
          b.style.removeProperty('--cmd-x');
          b.style.removeProperty('--cmd-y');
        }
      };
      const setDock = (d: string) => {
        dock = d;
        localStorage.setItem('cmdDock', d);
        applyDock(d);
      };
      // mobile: always bottom, dragging off; desktop: restore the saved dock
      const restoreDock = () => applyDock(coarse ? 'bottom' : dock);
      document.addEventListener('astro:after-swap', restoreDock);
      restoreDock();

      const EDGE = () => Math.min(150, innerWidth * 0.18);
      const zoneFor = (x: number, y: number) => {
        const e = EDGE();
        if (y > innerHeight - e) return 'bottom';
        if (y < e) return 'top';
        if (x < e) return 'left';
        if (x > innerWidth - e) return 'right';
        return 'float';
      };
      const clampFloat = (x: number, y: number) => ({
        x: Math.min(Math.max(x - 150, 8), innerWidth - 300),
        y: Math.min(Math.max(y - 24, 8), innerHeight - 120),
      });
      const showGhost = (zone: string, x: number, y: number) => {
        const g = ghostEl();
        if (!g) return;
        const t = 52;
        let r;
        if (zone === 'bottom') r = { left: 0, top: innerHeight - t, width: innerWidth, height: t };
        else if (zone === 'top') r = { left: 0, top: 0, width: innerWidth, height: t };
        else if (zone === 'left') r = { left: 0, top: 0, width: t * 1.5, height: innerHeight };
        else if (zone === 'right') r = { left: innerWidth - t * 1.5, top: 0, width: t * 1.5, height: innerHeight };
        else {
          const p = clampFloat(x, y);
          r = { left: p.x, top: p.y, width: 300, height: 92 };
        }
        g.classList.remove('hidden');
        g.style.left = r.left + 'px';
        g.style.top = r.top + 'px';
        g.style.width = r.width + 'px';
        g.style.height = r.height + 'px';
      };

      let dragging = false;
      let zone = 'bottom';
      document.addEventListener('pointerdown', (e) => {
        if (coarse) return; // mobile: dragging disabled
        const b = (e.target as HTMLElement).closest?.('#command-bar') as HTMLElement | null;
        if (!b) return;
        const t = e.target as HTMLElement;
        const onHandle = t.closest('[data-cmd-handle]');
        // grab the background or the handle — never a chip or a link
        if (!onHandle && (t.closest('.cmd-chip') || t.closest('a'))) return;
        dragging = true;
        zone = dock;
        b.classList.add('cmd-dragging');
        b.setPointerCapture?.(e.pointerId);
        e.preventDefault();
      });
      document.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        zone = zoneFor(e.clientX, e.clientY);
        showGhost(zone, e.clientX, e.clientY);
      });
      document.addEventListener('pointerup', (e) => {
        if (!dragging) return;
        dragging = false;
        bar()?.classList.remove('cmd-dragging');
        ghostEl()?.classList.add('hidden');
        if (zone === 'float') {
          floatPos = clampFloat(e.clientX, e.clientY);
          localStorage.setItem('cmdFloatPos', JSON.stringify(floatPos));
        }
        setDock(zone);
      });
      // double-click the handle: reset to the bottom
      document.addEventListener('dblclick', (e) => {
        if (!(e.target as HTMLElement).closest?.('[data-cmd-handle]')) return;
        floatPos = null;
        localStorage.removeItem('cmdFloatPos');
        setDock('bottom');
      });
    </script>
  </body>
</html>
