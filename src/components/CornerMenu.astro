---
/**
 * Corner menu (spec §32) — a terminal-style option panel. The TRIGGER now lives
 * on the command-bar logo lockup (CommandBar.astro, `[data-corner-toggle]`), so
 * this component renders only the panel. The open handler is a DELEGATED document
 * listener because the command bar re-renders on soft-nav; the "more options"
 * tooltip on the trigger is pure CSS, so it needs no binding.
 *
 * PANEL: a red left rail (50vw desktop, full-width below the tablet breakpoint).
 * Options are large lowercase Departure Mono labels — no icons, no boxes, no top
 * wordmark. The hovered/focused option shows a blinking "_" caret; ↑/↓ move it,
 * Enter activates. A dark-red reactive pixel dither brightens under the cursor
 * (darken-only, so white labels stay ≥ AA on #c90500). All JS nonced.
 *
 * x has no configured destination, so it stays DISABLED ("soon"). Farcaster is
 * deferred (spec §34): its Pass 22 backend (manifest, fc:miniapp embed, OG card)
 * stays live-but-dormant, but there is no UI entry for it. GitHub lives in the
 * footer.
 */
const X_URL: string | null = null;
if (!X_URL) console.warn('[corner-menu] x option disabled — no public destination in the social config');

interface Opt { label: string; href: string | null; external?: boolean }
const OPTIONS: Opt[] = [
  { label: 'ambient', href: '/ambient' },
  { label: 'rss', href: '/rss.xml' },
  { label: 'x', href: X_URL, external: true },
  { label: 'badges', href: '/badges' },
];
---

<div class="corner-menu" data-corner-menu transition:persist="corner-menu">
  <nav class="corner-panel" id="corner-panel" aria-label="Ethereum Beat menu" aria-hidden="true">
    <canvas class="corner-tex" data-corner-tex aria-hidden="true"></canvas>
    <ul class="corner-term" role="menu" data-corner-list>
      {
        OPTIONS.map((o) =>
          o.href ? (
            <li role="none">
              <a
                class="corner-opt"
                role="menuitem"
                href={o.href}
                data-opt
                {...(o.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {o.label}
              </a>
            </li>
          ) : (
            <li role="none">
              <span class="corner-opt corner-opt--disabled" role="menuitem" aria-disabled="true" tabindex="-1" data-opt data-disabled>
                {o.label} <span class="corner-soon">soon</span>
              </span>
            </li>
          ),
        )
      }
    </ul>
    <button type="button" class="corner-close" data-corner-close aria-label="Close menu">esc ✕</button>
  </nav>
</div>

<script>
  // Nonced by the Worker. The trigger ([data-corner-toggle]) lives in the command
  // bar (re-rendered on soft-nav), so opening is DELEGATED on document; the panel
  // container persists, so per-panel listeners bind once.
  const initCornerMenu = () => {
    const root = document.querySelector('[data-corner-menu]') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    const panel = root.querySelector('#corner-panel') as HTMLElement | null;
    const opts = [...root.querySelectorAll('[data-opt]')] as HTMLElement[];
    if (!panel || !opts.length) return;
    root.dataset.bound = '1';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;

    const trigger = () => document.querySelector('[data-corner-toggle]') as HTMLElement | null;
    const setActive = (i: number) => {
      active = (i + opts.length) % opts.length;
      opts.forEach((o, n) => o.classList.toggle('corner-opt--active', n === active));
    };
    const isOpen = () => root.classList.contains('corner-open');
    const setOpen = (open: boolean) => {
      root.classList.toggle('corner-open', open);
      trigger()?.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      if (open) { setActive(0); opts[0]?.focus(); startTexture(); }
      else { stopTexture(); trigger()?.focus(); }
    };

    // delegated open/toggle + click-outside (survives the command bar re-render)
    document.addEventListener('click', (e) => {
      const t = e.target instanceof Element ? e.target.closest('[data-corner-toggle]') : null;
      if (t) { e.preventDefault(); e.stopPropagation(); setOpen(!isOpen()); return; }
      if (isOpen() && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    });

    // the tooltip is position:fixed (to escape the command bar's overflow clip),
    // so pin it above the trigger on hover / focus; CSS handles show + border-draw
    const positionTip = (t: Element) => {
      const tip = t.querySelector('.corner-tip') as HTMLElement | null;
      if (!tip) return;
      const r = t.getBoundingClientRect();
      tip.style.left = `${Math.round(r.left)}px`;
      tip.style.top = 'auto';
      tip.style.bottom = `${Math.round(window.innerHeight - r.top + 8)}px`;
    };
    const onTipHint = (e: Event) => {
      const t = e.target instanceof Element ? e.target.closest('[data-corner-toggle]') : null;
      if (t) positionTip(t);
    };
    document.addEventListener('pointerover', onTipHint);
    document.addEventListener('focusin', onTipHint);
    root.querySelector('[data-corner-close]')?.addEventListener('click', () => setOpen(false));
    opts.forEach((o, i) => {
      o.addEventListener('mouseenter', () => setActive(i));
      o.addEventListener('focus', () => setActive(i));
      o.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { e.preventDefault(); setOpen(false); return; }
      if (!isOpen()) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); opts[active]?.focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); opts[active]?.focus(); }
      else if (e.key === 'Enter') {
        const el = opts[active];
        if (el && !el.dataset.disabled && el instanceof HTMLAnchorElement) el.click();
      }
    });

    // ── reactive pixel texture (§31.D) — dark-red dither, cursor spotlight ──
    const canvas = root.querySelector('[data-corner-tex]') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d') ?? null;
    const CELL = 16, BASE = 0.05, MAX = 0.34, SPOT = 5;
    let cols = 0, rows = 0, dpr = 1;
    let base = new Float32Array(0), level = new Float32Array(0);
    let raf = 0, texOn = false;
    const mouse = { x: -999, y: -999 };

    const resize = () => {
      if (!canvas || !ctx) return;
      dpr = Math.min(2, window.devicePixelRatio || 1);
      const r = panel.getBoundingClientRect();
      canvas.width = Math.max(1, Math.round(r.width * dpr));
      canvas.height = Math.max(1, Math.round(r.height * dpr));
      cols = Math.ceil(r.width / CELL);
      rows = Math.ceil(r.height / CELL);
      base = new Float32Array(cols * rows);
      level = new Float32Array(cols * rows);
      for (let i = 0; i < base.length; i++) {
        base[i] = BASE * (0.35 + ((i * 2654435761) % 1000) / 1000 * 0.65);
        level[i] = base[i];
      }
    };
    const paint = () => {
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const s = CELL * dpr;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const a = level[y * cols + x];
          if (a < 0.02) continue;
          ctx.fillStyle = `rgba(58,0,0,${Math.min(MAX, a)})`;
          ctx.fillRect(x * s + s * 0.16, y * s + s * 0.16, s * 0.68, s * 0.68);
        }
      }
    };
    const tick = () => {
      const mx = mouse.x / CELL, my = mouse.y / CELL;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const dx = x - mx, dy = y - my;
          const d = Math.sqrt(dx * dx + dy * dy);
          const spot = d < SPOT ? (1 - d / SPOT) : 0;
          const target = base[i] + spot * (MAX - base[i]);
          level[i] += (target - level[i]) * 0.22;
        }
      }
      paint();
      if (texOn) raf = window.requestAnimationFrame(tick);
    };
    const onMove = (e: PointerEvent) => {
      const r = panel.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    };
    const onLeave = () => { mouse.x = -999; mouse.y = -999; };
    // arrow consts so the panel null-narrowing is preserved under astro check
    const startTexture = () => {
      if (!canvas || !ctx) return;
      resize();
      paint();
      if (reduce) return; // static dither only, no ripple loop
      texOn = true;
      panel.addEventListener('pointermove', onMove);
      panel.addEventListener('pointerleave', onLeave);
      raf = window.requestAnimationFrame(tick);
    };
    const stopTexture = () => {
      texOn = false;
      window.cancelAnimationFrame(raf);
      panel.removeEventListener('pointermove', onMove);
      panel.removeEventListener('pointerleave', onLeave);
    };
    window.addEventListener('resize', () => { if (isOpen()) { resize(); paint(); } });
  };
  initCornerMenu();
  document.addEventListener('astro:page-load', initCornerMenu);
</script>
