---
/**
 * Corner menu (spec §28.C): global site chrome on every non-ambient route. A
 * blinking signal-red arrow in the bottom-right corner expands a LARGE red panel
 * with big square tiles for the site's ancillary destinations. The main site nav
 * (channels, about, roadmap, GitHub) stays in the footer; this holds the extras.
 *
 * Palette (documented in DESIGN.md): the panel is a fixed #c90500 signal-red
 * field with pure-white ink + icons — white on #c90500 is 6.07:1, clearing WCAG
 * AA for normal text (no large-text-tier reliance). Icons are hand-drawn 1px
 * monochrome SVGs in the structural-index style — no icon font/library. All JS
 * is nonced by the Worker; no inline handlers.
 *
 * Farcaster + X were dropped from the tile set: the repo carries no Farcaster
 * profile URL and no X handle (only a runtime FID secret + a manual X-draft), so
 * inventing warpcast/x.com URLs was declined. GitHub is the one real outbound
 * project link.
 */
const REPO = 'https://github.com/ethereumbeat/ethereum-beat';
const TILES = [
  { href: '/ambient', label: 'ambient', icon: 'ambient', external: false },
  { href: '/rss.xml', label: 'rss', icon: 'rss', external: false },
  { href: '/badges', label: 'badges', icon: 'badges', external: false },
  { href: REPO, label: 'github', icon: 'github', external: true },
] as const;
---

<div class="corner-menu" data-corner-menu transition:persist="corner-menu">
  <button
    type="button"
    class="corner-arrow"
    data-corner-toggle
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="corner-panel"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <!-- a chevron opening up-left into the panel -->
      <path d="M4 20 L12 6 L20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
  </button>

  <div class="corner-panel" id="corner-panel" role="menu" aria-label="Ethereum Beat menu" aria-hidden="true">
    <p class="corner-panel-kicker">ethereum beat</p>
    <div class="corner-panel-grid">
      {
        TILES.map((t) => (
          <a
            class="corner-tile"
            href={t.href}
            role="menuitem"
            {...(t.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="corner-tile-icon" aria-hidden="true">
              {t.icon === 'ambient' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                  <rect x="2.5" y="4.5" width="19" height="12.5" rx="1" />
                  <polygon points="12,7.5 9,11.5 12,15.5 15,11.5" />
                  <path d="M9.5 20.5 h5" />
                </svg>
              )}
              {t.icon === 'rss' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                  <circle cx="5.5" cy="18.5" r="1.6" fill="currentColor" stroke="none" />
                  <path d="M4.5 11.5 a8 8 0 0 1 8 8" />
                  <path d="M4.5 5.5 a14 14 0 0 1 14 14" />
                </svg>
              )}
              {t.icon === 'badges' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                  <circle cx="12" cy="9" r="5.2" />
                  <path d="M8.6 13.4 L7.5 21 L12 18 L16.5 21 L15.4 13.4" />
                  <path d="M10 9 l1.6 1.6 L14.4 7.4" />
                </svg>
              )}
              {t.icon === 'github' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
                  <circle cx="7" cy="6" r="2" />
                  <circle cx="7" cy="18" r="2" />
                  <circle cx="17" cy="9.5" r="2" />
                  <path d="M7 8 v8 M7 12.5 h6.4 a2.6 2.6 0 0 0 2.6 -2.6 v-.4" />
                </svg>
              )}
            </span>
            <span class="corner-tile-label">{t.label}</span>
          </a>
        ))
      }
    </div>
    <button type="button" class="corner-close" data-corner-close aria-label="Close menu">esc ✕</button>
  </div>
</div>

<script>
  // Nonced by the Worker. Idempotent bind that survives view transitions
  // (the element uses transition:persist, so bind once and re-check on load).
  const initCornerMenu = () => {
    const root = document.querySelector('[data-corner-menu]') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const btn = root.querySelector('[data-corner-toggle]') as HTMLElement | null;
    const panel = root.querySelector('#corner-panel') as HTMLElement | null;
    if (!btn || !panel) return;

    const setOpen = (open: boolean) => {
      root.classList.toggle('corner-open', open);
      btn.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
    };
    const isOpen = () => root.classList.contains('corner-open');

    btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!isOpen()); });
    root.querySelector('[data-corner-close]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false); });
    document.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    });
    // close after choosing a destination
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  };
  initCornerMenu();
  document.addEventListener('astro:page-load', initCornerMenu);
</script>
