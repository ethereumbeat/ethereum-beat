---
/**
 * Corner menu (spec §29.A-D): a LEFT-anchored, full viewport-height red rail,
 * opened by a blinking arrow at the bottom-left beside the ETHEREUM BEAT
 * wordmark. Tiles are a vertical column of large square buttons with custom 1px
 * house-style SVG icons; the wordmark is lowercase grotesk.
 *
 * Palette (documented in DESIGN.md): a fixed #c90500 signal-red field with
 * pure-white ink + icons — white on #c90500 is 6.07:1, clearing WCAG AA for
 * normal text. All JS is nonced by the Worker; no inline handlers.
 *
 * Farcaster + X destinations are resolved from the social broadcast config.
 * Both are absent today — only a runtime Farcaster FID secret and a manual
 * X-draft exist, no public profile URL / handle — so their tiles render in a
 * visible DISABLED state and the build logs a warning. They are NEVER
 * substituted with GitHub or any other destination (the Pass 17 silent-fallback
 * bug). GitHub is not in this menu; it lives in the footer.
 */

// Social destinations from config. null → no public destination → disabled tile.
// Do NOT hardcode a fabricated profile URL here; set these only from a real
// config value if one is ever added.
const FARCASTER_URL: string | null = null;
const X_URL: string | null = null;

if (!FARCASTER_URL)
  console.warn('[corner-menu] farcaster tile DISABLED — no public Farcaster destination in the social config (only a runtime FID secret exists)');
if (!X_URL)
  console.warn('[corner-menu] x tile DISABLED — no public X destination in the social config (X broadcast is a manual draft only)');

interface Tile {
  label: string;
  href: string | null;
  icon: 'ambient' | 'rss' | 'farcaster' | 'x' | 'badges';
  external?: boolean;
}
const TILES: Tile[] = [
  { label: 'ambient', href: '/ambient', icon: 'ambient' },
  { label: 'rss', href: '/rss.xml', icon: 'rss' },
  { label: 'farcaster', href: FARCASTER_URL, icon: 'farcaster', external: true },
  { label: 'x', href: X_URL, icon: 'x', external: true },
  { label: 'badges', href: '/badges', icon: 'badges' },
];
---

<div class="corner-menu" data-corner-menu transition:persist="corner-menu">
  <button
    type="button"
    class="corner-arrow"
    data-corner-toggle
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="corner-panel"
  >
    <!-- chevron opening rightward out of the left edge -->
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 4 L16 12 L8 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="miter" stroke-linecap="butt" />
    </svg>
  </button>

  <div class="corner-panel" id="corner-panel" role="menu" aria-label="Ethereum Beat menu" aria-hidden="true">
    <p class="corner-panel-kicker">ethereum beat</p>
    <div class="corner-panel-col">
      {
        TILES.map((t) => {
          const icon = (
            <span class="corner-tile-icon" aria-hidden="true">
              {t.icon === 'ambient' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="butt">
                  <rect x="3" y="4" width="18" height="13" />
                  <path d="M9 20 H15" />
                  <path d="M6 11 H9 L10.5 7.5 L12.5 14.5 L14 11 H18" />
                </svg>
              )}
              {t.icon === 'rss' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="butt">
                  <rect x="4.2" y="16.8" width="3" height="3" fill="currentColor" stroke="none" />
                  <path d="M4.5 12 A7.5 7.5 0 0 1 12 19.5" />
                  <path d="M4.5 7 A12.5 12.5 0 0 1 17 19.5" />
                  <path d="M4.5 4 L4.5 4" />
                </svg>
              )}
              {t.icon === 'farcaster' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="butt">
                  <path d="M6 20 V9 L12 5 L18 9 V20" />
                  <path d="M4.5 9 H8" />
                  <path d="M16 9 H19.5" />
                  <path d="M9 20 V13 H15 V20" />
                </svg>
              )}
              {t.icon === 'x' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="butt">
                  <path d="M5 5 L19 19" />
                  <path d="M19 5 L5 19" />
                </svg>
              )}
              {t.icon === 'badges' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="butt">
                  <path d="M12 3 L19 6 V11 L12 21 L5 11 V6 Z" />
                  <path d="M8.5 10.5 L11 13 L15.5 8" />
                </svg>
              )}
            </span>
          );
          return t.href ? (
            <a class="corner-tile" href={t.href} role="menuitem" {...(t.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {icon}
              <span class="corner-tile-label">{t.label}</span>
            </a>
          ) : (
            <span class="corner-tile corner-tile--disabled" role="menuitem" aria-disabled="true" title="no public destination configured yet">
              {icon}
              <span class="corner-tile-label">{t.label} <span class="corner-tile-note">soon</span></span>
            </span>
          );
        })
      }
    </div>
    <button type="button" class="corner-close" data-corner-close aria-label="Close menu">esc ✕</button>
  </div>
</div>

<script>
  // Nonced by the Worker. Idempotent bind that survives view transitions.
  const initCornerMenu = () => {
    const root = document.querySelector('[data-corner-menu]') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const btn = root.querySelector('[data-corner-toggle]') as HTMLElement | null;
    const panel = root.querySelector('#corner-panel') as HTMLElement | null;
    if (!btn || !panel) return;

    const setOpen = (open: boolean) => {
      root.classList.toggle('corner-open', open);
      btn.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
    };
    const isOpen = () => root.classList.contains('corner-open');

    btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!isOpen()); });
    root.querySelector('[data-corner-close]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setOpen(false); });
    document.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Node && !root.contains(e.target)) setOpen(false);
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  };
  initCornerMenu();
  document.addEventListener('astro:page-load', initCornerMenu);
</script>
